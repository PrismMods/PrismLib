<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
        Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{2F4A7E91-55C3-4B0E-9D12-8A6E3C41F7D2}</ProjectGuid>
        <OutputType>Library</OutputType>
        <RootNamespace>PrismLib.UI</RootNamespace>
        <AssemblyName>PrismLib.UI</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <Deterministic>true</Deterministic>
        <!-- Unity lives here. Never hardcode a home directory; accept either shipped layout. -->
        <AdofaiRoot Condition=" '$(AdofaiRoot)' == '' ">$(HOME)/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice</AdofaiRoot>
        <AdofaiManaged Condition=" Exists('$(AdofaiRoot)/ADanceOfFireAndIce_Data/Managed/Assembly-CSharp.dll') ">$(AdofaiRoot)/ADanceOfFireAndIce_Data/Managed</AdofaiManaged>
        <AdofaiManaged Condition=" '$(AdofaiManaged)' == '' ">$(AdofaiRoot)/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed</AdofaiManaged>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <!-- Separate assembly from PrismLib.dll on purpose: the arbitration half stays plain BCL, so
         it loads before anything and its logic is testable outside the game. Only this half needs
         Unity, and only mods that draw something ever load it. -->
    <ItemGroup>
        <Reference Include="System" />
        <Reference Include="netstandard"><HintPath>$(AdofaiManaged)/netstandard.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine"><HintPath>$(AdofaiManaged)/UnityEngine.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(AdofaiManaged)/UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.UI"><HintPath>$(AdofaiManaged)/UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.UIModule"><HintPath>$(AdofaiManaged)/UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(AdofaiManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(AdofaiManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Unity.TextMeshPro"><HintPath>$(AdofaiManaged)/Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Properties\AssemblyInfo.cs" />
        <Compile Include="RoundedRectGraphic.cs" />
        <Compile Include="ToastStack.cs" />
        <Compile Include="Toast.cs" />
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
